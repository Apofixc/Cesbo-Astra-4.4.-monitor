***0         local prev_lock = bit32.band(prev.status or 0, 0x10) ~= 0
***0         local curr_lock = bit32.band(curr.status or 0, 0x10) ~= 0
***0         return prev_lock ~= curr_lock or ratio(prev.quality or 0, quality or 0) > rate
