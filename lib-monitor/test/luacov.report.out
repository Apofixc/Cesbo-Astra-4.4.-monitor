***0         return (prev.status or -1) ~= (curr.status or -1) or
***0                ratio(prev.signal or 0, curr.signal or 0) > rate or
***0                ratio(prev.snr or 0, curr.snr or 0) > rate or
***0                (prev.ber or -1) ~= (curr.ber or -1) or
***0                (prev.unc or -1) ~= (curr.unc or -1)
