      --- Сопоставляет имя события со всеми активными масками за один проход.
      --- Реализует гибридное сегментированное дерево (Segmented Trie) для оптимизации.
      --- @param name string Имя события
      --- @param patterns table<string, any> Список активных паттернов (ключи - паттерны)
      --- @return table Список совпавших паттернов
   24 function Wildcard.match_multiple(name, patterns)
    7     if not name or type(name) ~= "string" then return {} end
    5     if not patterns or type(patterns) ~= "table" then return {} end

          -- Если паттернов мало, используем быстрый линейный перебор
    4     local count = 0
   47     for _ in pairs(patterns) do count = count + 1 end
    4     if count < 10 then
    1         local result = {}
    4         for p in pairs(patterns) do
    3             if Wildcard.compile(p)(name) then
    1                 table_insert(result, p)
                  end
              end
    1         return result
          end

          -- Построение дерева решений (ленивая инициализация)
    3     if not state.decision_tree then
    3         local tree = { exact = {}, wild = {}, patterns = {} }
   43         for p in pairs(patterns) do
   40             local current = tree
                  -- Разбиваем паттерн на сегменты
  100             for segment in p:gmatch("[^:.]+") do
   60                 if segment == "*" then
                          -- Catch-all сегмент
    4                     current.catch_all = current.catch_all or { exact = {}, wild = {}, patterns = {} }
    4                     current = current.catch_all
   56                 elseif string_find(segment, "[*%?]") then
                          -- Сегмент с маской (например, "chan*")
    2                     current.wild = current.wild or {}
    2                     if not current.wild[segment] then
    2                         current.wild[segment] = {
    2                             matcher = Wildcard.compile(segment), -- Компилируем как отдельный матчер
    2                             node = { exact = {}, wild = {}, patterns = {} }
    2                         }
                          end
    2                     current = current.wild[segment].node
                      else
                          -- Точный сегмент
   54                     current.exact = current.exact or {}
   54                     current.exact[segment] = current.exact[segment] or { exact = {}, wild = {}, patterns = {} }
   54                     current = current.exact[segment]
                      end
                  end
   40             table_insert(current.patterns, p)
              end
    3         state.decision_tree = tree
          end

          -- Рекурсивный поиск по дереву
    3     local result = {}
    3     local seen = {} -- Защита от дубликатов (один паттерн может подойти разными путями)

          local function search(node, segments, idx)
   14         local is_end = (idx > #segments)

              -- Добавляем паттерны текущего узла
   20         for i = 1, #node.patterns do
    6             local p = node.patterns[i]
    6             if not seen[p] then
                      -- Паттерн в узле считается совпавшим, если:
                      -- 1. Мы дошли до конца сообщения (точное совпадение по сегментам)
                      -- 2. ИЛИ паттерн заканчивается на * (он "жадный" и может поглощать остаток)
    6                 if is_end then
    5                     table_insert(result, p)
    5                     seen[p] = true
    1                 elseif string_sub(p, -1) == "*" then
                          -- Для жадных паттернов проверяем совпадение со всей строкой
    1                     if Wildcard.compile(p)(name) then
    1                         table_insert(result, p)
    1                         seen[p] = true
                          end
                      end
                  end
