***0     for _, ch_data in pairs(channel_list) do
***0         local inputs = ch_data.input
***0         if type(inputs) == "table" then
***0             for i = 1, #inputs do
***0                 local input = inputs[i]
***0                 local is_match = false

***0                 if type(input) == "table" then
