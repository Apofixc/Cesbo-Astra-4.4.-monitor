      -- 5. Внутреннее состояние (Private State)
      --- @class TablePoolState
      --- @field pools table<string, table[]> Таблицы пулов: type -> { t1, t2, ... }
      --- @field cleaners table<string, function> Кастомные функции очистки: type -> function
