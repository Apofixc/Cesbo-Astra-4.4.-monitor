    1         matcher = _create_middle_matcher(pattern)
    5     elseif not string_find(pattern, "?", 1, true) then
              -- 6. Оптимизация: Множественные сегменты (только *)
    4         matcher = _create_segments_matcher(pattern)
          else
              -- 7. Общий случай: Регулярное выражение Lua (поддержка ?)
    1         matcher = _create_regex_matcher(pattern)
          end

          -- Управление кэшем (очистка при переполнении)
   23     if state.cache_size >= _m_config.MaxCacheSize.wildcard then
    1         state.compile_cache = {}
    1         state.cache_size = 0
          end

   23     state.compile_cache[pattern] = matcher
   23     state.cache_size = state.cache_size + 1

   23     return matcher
