        --- Обработчик данных от тюнера Astra (горячий путь)
        --- @private
        --- @param data table Данные от тюнера
     18 function TunerMonitor:_on_astra_data(data)
     30     if type(data) ~= "table" then return end

     30     local conf = self._astra_conf or self._config
     30     local master = self._current_status_table

            -- Накопление статистики для расчета качества (упрощенно)
     30     if conf.analyze and data.status and bit32_band(data.status, 0x10) ~= 0 then
                -- Используем значение из локального конфига модуля
      5         local max_stats = _m_config.MaxCounterValue
                -- Защита от переполнения при длительном отсутствии изменений
      5         if self._stats.count < max_stats then
      5             self._stats.ber_sum = self._stats.ber_sum + (data.ber or 0)
      5             self._stats.unc_sum = self._stats.unc_sum + (data.unc or 0)
      5             self._stats.count = self._stats.count + 1
                end
            end

            -- Расчет качества (quality) для метода сравнения
            local current_quality
     30     if conf.analyze and self._stats.count > 0 then
      7         local avg_ber = self._stats.ber_sum / self._stats.count
      7         if avg_ber > 0 or self._stats.unc_sum > 0 then
      4             local val = 100 - (avg_ber / 1000) - (self._stats.unc_sum * 10)
      4             current_quality = math_min(100, math_max(0, val))
                else
      3             current_quality = 100
                end
            else
