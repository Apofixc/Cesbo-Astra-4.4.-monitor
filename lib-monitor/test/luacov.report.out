      3                     stats.cc = (stats.cc + cc) > max_counter and max_counter or (stats.cc + cc)
      3                     stats.pes = (stats.pes + pes) > max_counter and max_counter or (stats.pes + pes)
      3                     stats.sc = (stats.sc + sc) > max_counter and max_counter or (stats.sc + sc)
                        end
                    end
                end
            end
