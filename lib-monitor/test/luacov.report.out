     62 function Utils.measure_time(name, func, ...)
      5     local start_time = os_clock()
      5     local results = { pcall(func, ...) }
      5     local end_time = os_clock()

      5     _update_stats(name, end_time - start_time)

      5     local ok = results[1]
      5     if not ok then
      1         error(results[2])
            end

      4     return unpack(results, 2)
        end

