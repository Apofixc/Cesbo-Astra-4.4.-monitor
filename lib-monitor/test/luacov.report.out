   1 function SubscriberRoutes.subscribe(server, client, request)
***0     local data = HttpHelpers.get_params(request)
***0     local ok, err = HttpHelpers.validate(data, {
             event_type = { type = "string", required = true },
             callback = { type = "table", required = true },
             batch_mode = { type = "string", values = { "single", "array" } },
             send_lvc = { type = "boolean" },
***0         throttle_ms = { type = "number", min = 0 }
         })
***0     if not ok then return HttpHelpers.error(server, client, 400, err) end

***0     local dispatcher = EventDispatcher.get_instance()
***0     local sub_id = dispatcher:subscribe(data.event_type, data.callback, data.filters, {
             batch_mode = data.batch_mode,
             send_lvc = data.send_lvc,
***0         throttle_ms = data.throttle_ms
         })

***0     if not sub_id then return HttpHelpers.error(server, client, 500, "Не удалось подписаться") end

***0     return HttpHelpers.success(server, client, { message = "Подписка оформлена", id = sub_id })
     end

     --- Удаляет существующую подписку по её уникальному ID.
