        -- ===========================================================================
        -- Модуль `adapters.tuner_monitor`
        --
        -- Класс для мониторинга физических DVB-адаптеров. Отслеживает уровень сигнала,
        -- SNR, ошибки BER/UNC и рассчитывает интегральный показатель качества.
        -- ===========================================================================

        -- 1. Стандартные Lua функции
     18 local math_max = _G.math.max
     18 local math_min = _G.math.min
     18 local os_time = _G.os.time
     18 local pairs = _G.pairs
     18 local setmetatable = _G.setmetatable
     18 local string_format = _G.string.format
     18 local tostring = _G.tostring
     18 local type = _G.type
     18 local bit32 = _G.bit32
     18 local pcall = _G.pcall
     18 local bit32_band = bit32.band

        -- 2. Функции из ModuleManager.get_module()
     18 local Logger = ModuleManager.get_module("logger")
     18 local Utils = ModuleManager.get_module("utils")
     18 local BaseMonitor = ModuleManager.get_module("core.base_monitor")
     18 local Scheduler = ModuleManager.get_module("core.scheduler")
     18 local TablePool = ModuleManager.get_module("utils.table_pool")

        -- 3. Глобальные зависимости Astra
     18 local dvb_tune = ModuleManager.get_global_dependency("dvb_tune")
     18 local analyze = ModuleManager.get_global_dependency("analyze")

        -- 4. Константы и конфигурации
     18 local COMPONENT_NAME = "TunerMonitor"

        -- Предварительно рассчитанная таблица состояний для всех возможных значений статуса (0-31)
        -- Это исключает циклы и побитовые операции в основном callback-е, обеспечивая максимальную производительность.
     18 local STATUS_LOOKUP = {}
    594 for i = 0, 31 do
    576     STATUS_LOOKUP[i] = {
    576         has_signal  = bit32.band(i, 0x01) ~= 0,
    576         has_carrier = bit32.band(i, 0x02) ~= 0,
    576         has_viterbi = bit32.band(i, 0x04) ~= 0,
    576         has_sync    = bit32.band(i, 0x08) ~= 0,
    576         has_lock    = bit32.band(i, 0x10) ~= 0,
    576     }
        end

        -- Методы сравнения
     18 local METHOD_ALWAYS = 1
     18 local METHOD_RATIO = 2
     18 local METHOD_LOCK_ONLY = 3
     18 local METHOD_ERROR_CRITICAL = 4
     18 local METHOD_QUALITY_RATIO = 5
     18 local METHOD_STATUS_ANY = 6
     18 local METHOD_SIGNAL_DROP = 7

     18 local ratio = Utils.ratio

     18 local COMPARISON_METHODS = {
            -- 1. Всегда отправлять отчет при каждой проверке
            [METHOD_ALWAYS] = function(prev, curr, rate, quality)
      1         return true
            end,

            -- 2. Любые изменения параметров через ratio
            [METHOD_RATIO] = function(prev, curr, rate, quality)
      4         return (prev.status or -1) ~= (curr.status or -1) or
      3                ratio(prev.signal or 0, curr.signal or 0) > rate or
      2                ratio(prev.snr or 0, curr.snr or 0) > rate or
      1                (prev.ber or -1) ~= (curr.ber or -1) or
      4                (prev.unc or -1) ~= (curr.unc or -1)
            end,

            -- 3. Только изменение бита Lock
            [METHOD_LOCK_ONLY] = function(prev, curr, rate, quality)
      1         local prev_lock = bit32.band(prev.status or 0, 0x10) ~= 0
      1         local curr_lock = bit32.band(curr.status or 0, 0x10) ~= 0
      1         return prev_lock ~= curr_lock
            end,

            -- 4. Изменение Lock или появление ошибок BER/UNC
            [METHOD_ERROR_CRITICAL] = function(prev, curr, rate, quality)
      1         local prev_lock = bit32.band(prev.status or 0, 0x10) ~= 0
      1         local curr_lock = bit32.band(curr.status or 0, 0x10) ~= 0
      1         return prev_lock ~= curr_lock or (curr.ber or 0) > 0 or (curr.unc or 0) > 0
            end,

            -- 5. Изменение Lock или расчетного показателя Quality
            [METHOD_QUALITY_RATIO] = function(prev, curr, rate, quality)
      1         local prev_lock = bit32.band(prev.status or 0, 0x10) ~= 0
      1         local curr_lock = bit32.band(curr.status or 0, 0x10) ~= 0
      1         return prev_lock ~= curr_lock or ratio(prev.quality or 0, quality or 0) > rate
            end,

            -- 6. Любое изменение битовой маски статуса (Signal, Carrier, Viterbi, Sync, Lock)
            [METHOD_STATUS_ANY] = function(prev, curr, rate, quality)
      1         return (prev.status or -1) ~= (curr.status or -1)
            end,

            -- 7. Изменение Lock или только падение уровня сигнала/SNR
            [METHOD_SIGNAL_DROP] = function(prev, curr, rate, quality)
      2         local prev_lock = bit32.band(prev.status or 0, 0x10) ~= 0
      2         local curr_lock = bit32.band(curr.status or 0, 0x10) ~= 0
      2         if prev_lock ~= curr_lock then return true end

      1         local is_signal_drop = (prev.signal or 0) > (curr.signal or 0) and
      1                                ratio(prev.signal or 0, curr.signal or 0) > rate
      1         local is_snr_drop = (prev.snr or 0) > (curr.snr or 0) and
      1                             ratio(prev.snr or 0, curr.snr or 0) > rate

      1         return is_signal_drop or is_snr_drop or (curr.ber or 0) > 0 or (curr.unc or 0) > 0
            end
        }

