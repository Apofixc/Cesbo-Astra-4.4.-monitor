     92     self.subscriptions = {} -- [event_type][subscription_id] = sub_data
     92     self.stats = { total = 0, delivered = 0, failed = 0 }
     92     self._matchers = {} -- [pattern] = function
     92     self._route_cache = {} -- [event_type] = { sub1, sub2, ... }
     92     self._route_cache_size = 0
     92     self._plan_cache = {} -- [event_type] = { simple_groups = {}, complex_subs = {} }
     92     self._save_pending = false
     92     self._batch_queues = {} -- [sub_id] = { events = {}, last_flush = T }
