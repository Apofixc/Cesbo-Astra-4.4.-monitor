***0         if prev_lock ~= curr_lock then return true end

***0         local is_signal_drop = (prev.signal or 0) > (curr.signal or 0) and
***0                                ratio(prev.signal or 0, curr.signal or 0) > rate
***0         local is_snr_drop = (prev.snr or 0) > (curr.snr or 0) and
***0                             ratio(prev.snr or 0, curr.snr or 0) > rate

***0         return is_signal_drop or is_snr_drop or (curr.ber or 0) > 0 or (curr.unc or 0) > 0
