        --- Находит все каналы в системе Astra, использующие указанный DVB-адаптер.
        --- Проверяет все входы канала.
        --- @param adapter_name string Имя адаптера (например, "0" или "0.1")
        --- @return table<string, table> Список найденных каналов (имя -> ch_data)
      6 function ChannelRepository:find_by_adapter(adapter_name)
      4     local result = {}
      4     local channel_list = ModuleManager.get_global_dependency("channel_list")

      4     if not channel_list then
      1         Logger.error(COMPONENT_NAME, "find_by_adapter: зависимость channel_list не найдена")
      1         return result
            end

      3     local target_adapter = tostring(adapter_name)
      6     for _, ch_data in pairs(channel_list) do
      3         local inputs = ch_data.input
      3         if type(inputs) == "table" then
      4             for i = 1, #inputs do
      3                 local input = inputs[i]
      3                 local is_match = false

      3                 if type(input) == "table" then
      2                     local cfg = input.config
      2                     if type(cfg) == "table" and cfg.format == "dvb" and tostring(cfg.addr or "") == target_adapter then
      1                         is_match = true
                            end
      1                 elseif type(input) == "string" then
      1                     local parsed = Utils.parse_url(input)
      1                     if parsed and parsed.format == "dvb" and tostring(parsed.addr) == target_adapter then
      1                         is_match = true
                            end
                        end

      3                 if is_match then
      2                     local name = (type(ch_data.config) == "table") and ch_data.config.name
      2                     if name then
      2                         result[name] = ch_data
                            end
                            -- Если нашли совпадение в одном из входов, переходим к следующему каналу
                            break
                        end
                    end
                end
            end

      3     return result
        end

        -- ===========================================================================
        -- Инициализация модуля
        -- ===========================================================================

      6 return ChannelRepository

