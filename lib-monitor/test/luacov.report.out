   1 local METHOD_RATIO = 2
   1 local METHOD_LOCK_ONLY = 3
   1 local METHOD_ERROR_CRITICAL = 4
   1 local METHOD_QUALITY_RATIO = 5
   1 local METHOD_STATUS_ANY = 6
   1 local METHOD_SIGNAL_DROP = 7

   1 local ratio = Utils.ratio

