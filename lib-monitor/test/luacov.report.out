        --- Добавляет событие в очередь на повторную отправку.
        --- @param config table Параметры транспорта
        --- @param event table|string Объект события или данные
        --- @param event_type string Тип события
        --- @param retry_count number Текущая попытка
        --- @param content string Подготовленный JSON
        --- @return boolean Статус добавления
    119 function SubscriptionManager:enqueue_retry(config, event, event_type, retry_count, content)
      5     if #self._retry_queue >= _m_config.MaxRetryQueueSize then
      1         Logger.warning(COMPONENT_NAME, "Очередь повторов переполнена, событие %s отброшено", event_type)
      1         return false
            end

      4     local delay = _m_config.RetryDelay * (2 ^ retry_count)
      4     local jitter = math_random() * 2

      4     local item = TablePool and TablePool.get("retry_item") or {}
      4     item.config = config
            -- Для ретрая делаем копию данных, если это была таблица из пула
      4     local retry_data = event
      4     if type(event) == "table" and event.is_table then
      1         retry_data = content
            end
      4     item.data = retry_data
      4     item.type = event_type
      4     item.retries = retry_count + 1
      4     item.time = os_clock() + delay + jitter

      4     table_insert(self._retry_queue, item)
      4     return true
        end

        --- Создает и инициализирует новый экземпляр SubscriptionManager
