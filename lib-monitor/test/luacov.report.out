    3         local instance = eventDispatcher.get_instance()
    6         instance:subscribe("config:updated:pool", function(new_config)
   11             if not new_config or type(new_config) ~= "table" then return end
   10             if new_config.MaxCacheSize and new_config.MaxCacheSize.wildcard then
    8                 _m_config.MaxCacheSize.wildcard = new_config.MaxCacheSize.wildcard
    8                 if Logger then
    8                     Logger.debug(COMPONENT_NAME, "Лимит кэша Wildcard обновлен: %d", _m_config.MaxCacheSize.wildcard)
                      end
