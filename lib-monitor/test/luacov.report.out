     25         Utils.init_report(r, "Channel", self._name)
     25         r.display_name = self._display_name
     25         r.monitor = self._config.monitor

                -- Оптимизация: прямое копирование полей (горячий путь)
     25         r.input_id = active_id
     25         r.status = master.status
     25         r.bitrate = master.bitrate
     25         r.cc_errors = master.cc_errors
     25         r.pes_errors = master.pes_errors
     25         r.scrambled = master.scrambled
     25         r.ready = master.ready
     25         r.stream = master.stream
     25         r.format = master.format
     25         r.addr = master.addr
     25         r.timestamp = master.timestamp

                -- Сбрасываем счетчики ошибок после отправки отчета
