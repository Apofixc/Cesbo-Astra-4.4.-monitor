  32     STATUS_LOOKUP[i] = {
  32         has_signal  = bit32.band(i, 0x01) ~= 0,
  32         has_carrier = bit32.band(i, 0x02) ~= 0,
  32         has_viterbi = bit32.band(i, 0x04) ~= 0,
  32         has_sync    = bit32.band(i, 0x08) ~= 0,
  32         has_lock    = bit32.band(i, 0x10) ~= 0,
