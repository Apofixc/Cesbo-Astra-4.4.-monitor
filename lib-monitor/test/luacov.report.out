   1 function HttpHelpers.validate(params, schema)
***0     if not params then return false, "Параметры не предоставлены" end
***0     if not schema then return true end

***0     for key, rules in pairs(schema) do
***0         local val = params[key]

***0         if rules.required and val == nil then
***0             return false, string.format("Параметр '%s' обязателен", key)
             end

***0         if val ~= nil then
***0             if rules.type and type(val) ~= rules.type then
***0                 if rules.type == "number" and (type(val) == "string" or type(val) == "boolean") then
***0                     val = tonumber(val)
***0                     if val == nil then
***0                         return false, string.format("Параметр '%s' должен быть числом", key)
                         end
***0                     params[key] = val
***0                 elseif rules.type == "boolean" and type(val) == "string" then
***0                     if val == "true" then val = true
***0                     elseif val == "false" then val = false
                         else
***0                         return false, string.format("Параметр '%s' должен быть логическим значением (boolean)", key)
                         end
***0                     params[key] = val
                     else
***0                     return false, string.format("Параметр '%s' должен иметь тип %s", key, rules.type)
                     end
                 end

***0             if rules.type == "number" then
***0                 if rules.min and val < rules.min then
***0                     return false, string.format("Параметр '%s' слишком мал (минимум: %s)", key, tostring(rules.min))
                     end
***0                 if rules.max and val > rules.max then
***0                     return false, string.format("Параметр '%s' слишком велик (максимум: %s)", key, tostring(rules.max))
                     end
                 end

***0             if rules.type == "string" and rules.pattern then
***0                 if not string_match(val, rules.pattern) then
***0                     return false, string.format("Параметр '%s' имеет неверный формат", key)
                     end
                 end

***0             if rules.values then
***0                 local found = false
***0                 for _, allowed in pairs(rules.values) do
***0                     if val == allowed then
***0                         found = true
                             break
                         end
                     end
***0                 if not found then
***0                     return false, string.format("Параметр '%s' имеет недопустимое значение", key)
                     end
                 end
             end
         end

***0     return true
     end

   1 return HttpHelpers

