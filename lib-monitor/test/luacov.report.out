      --- Компилирует маску в функцию сопоставления.
      --- Поддерживает оптимизированные пути для частых случаев (префиксы, суффиксы, сегменты).
      --- @param pattern string Маска (например, "channel:*", "adapter:1", "*", "a?c")
      --- @return function Функция-матчер
   24 function Wildcard.compile(pattern)
   26     if not pattern or type(pattern) ~= "string" then
    4         return function() return false end
          end

          -- Проверка кэша
   24     local cached = state.compile_cache[pattern]
   24     if cached then return cached end

          local matcher

          -- Определение стратегии компиляции
   23     if pattern == "*" then
              -- 1. Любая строка (Оптимизировано: константная функция)
    2         matcher = _create_any_matcher()
   21     elseif not string_find(pattern, "[%*%?]") then
              -- 2. Прямое сравнение (нет спецсимволов)
    8         matcher = _create_exact_matcher(pattern)
   13     elseif string_match(pattern, "^[^%*%?]+%*$") then
              -- 3. Оптимизация: Префикс "prefix:*"
    6         matcher = _create_prefix_matcher(pattern)
    7     elseif string_match(pattern, "^%*[^%*%?]+$") then
              -- 4. Оптимизация: Суффикс "*:suffix"
    1         matcher = _create_suffix_matcher(pattern)
    6     elseif string_match(pattern, "^%*[^%*%?]+%*$") then
