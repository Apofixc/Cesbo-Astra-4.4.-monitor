statsfile = "/opt/Cesbo-Astra-4.4.-monitor/lib-monitor/test/luacov.stats.out"
reportfile = "/opt/Cesbo-Astra-4.4.-monitor/lib-monitor/test/luacov.report.out"

include = {
    "opt/Cesbo-Astra-4.4.-monitor/lib%-monitor/src/.*",
    "opt/Cesbo-Astra-4.4.-monitor/lib%-monitor/http/.*",
    -- Добавьте относительные пути, если запуск идет из /opt/astra/lib-monitor
    "src/.*",
    "http/.*"
}

exclude = {
    "^/opt/Cesbo-Astra-4.4.-monitor/lib-monitor/test/.+$"
}

runreport = true
deletestats = true
