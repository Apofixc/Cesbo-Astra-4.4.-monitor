    10 function Scheduler:_tick()
           -- Оптимизация: быстрый выход если задач нет
*****0     if #self._heap == 0 then return end
*****0     local now = _G.os.clock()

           -- Выполняем все задачи, время которых пришло
*****0     while #self._heap > 0 do
